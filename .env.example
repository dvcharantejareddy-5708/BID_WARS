# ==============================================================================
# BID WARS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO THIS FILE OR TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT ACCESSIBLE (Vite - Safe Public Keys only)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER ONLY (NEVER EXPOSE TO BROWSER BUNDLES)
# ------------------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Server Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional: Google AI Gemini API Key (Backend only)
GEMINI_API_KEY=your-gemini-api-key
