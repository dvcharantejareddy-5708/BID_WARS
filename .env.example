# BID WARS - Environment Configuration Example

# Server Port
PORT=3001
HOST=0.0.0.0

# Optional: Supabase PostgreSQL credentials (if deploying to Supabase)
# Leave empty to use the embedded high-performance server-authoritative engine
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
